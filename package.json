{
  "name": "@pons-network/pons.js",
  "version": "0.1.3",
  "description": "Pons Network SDK - Decentralized cross-chain execution layer",
  "keywords": [
    "pons",
    "cross-chain",
    "usdc",
    "smart-account",
    "decentralized",
    "multi-chain",
    "interoperability",
    "defi",
    "ethereum"
  ],
  "author": "Pons Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PonsNetwork/pons.js.git"
  },
  "bugs": {
    "url": "https://github.com/PonsNetwork/pons.js/issues"
  },
  "homepage": "https://pons.sh",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js",
      "require": "./dist/widget/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsup": "^8.3.5",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  }
}
